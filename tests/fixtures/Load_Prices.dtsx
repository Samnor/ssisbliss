          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.LoadLog WHERE Package = N'Load_Prices') THROW 50001, N'no rows loaded', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
